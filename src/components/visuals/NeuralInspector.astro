---
const dims = [
  { range: 'DIM 0..192', value: '0.871', tone: 'text-indigo-400' },
  { range: 'DIM 193..384', value: '0.934', tone: 'text-sky-400' },
  { range: 'DIM 385..576', value: '0.612', tone: 'text-emerald-400' },
  { range: 'DIM 577..768', value: '0.785', tone: 'text-amber-400' },
];
---

<div class="rounded-2xl bg-zinc-950 border border-zinc-800 dark:border-slate-800 p-5 font-mono text-xs text-zinc-300 shadow-2xl">
  <div
    class="flex items-center justify-between pb-3 border-b border-zinc-800/80 text-zinc-400 text-[11px] mb-4"
  >
    <span class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-red-500/90 inline-block"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/90 inline-block"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-green-500/90 inline-block"></span>
      <span class="ml-2 text-zinc-400">neural-inspector.wasm</span>
    </span>
    <span
      class="text-indigo-400 font-mono text-[10px] bg-indigo-950/70 px-2 py-0.5 rounded border border-indigo-800/50"
      >dim: 768 • sub-15ms</span
    >
  </div>

  <div class="space-y-3 text-[12px]">
    <div class="p-3 rounded-lg bg-zinc-900/90 border border-zinc-800/90">
      <div
        class="flex justify-between items-center text-[10px] text-zinc-500 mb-1.5 uppercase tracking-wider"
      >
        <span>Query Input Vector</span>
        <span class="text-emerald-400 font-medium">cosine: 0.942</span>
      </div>
      <p class="text-zinc-200 font-sans text-xs">
        "autonomous low-latency memory consolidation in WASM"
      </p>
    </div>

    <div class="grid grid-cols-4 gap-2 pt-1 text-[11px]">
      {
        dims.map((dim) => (
          <div class="p-2 rounded bg-zinc-900/60 border border-zinc-800/60 text-center">
            <div class="text-[10px] text-zinc-500">{dim.range}</div>
            <div class:list={['font-bold mt-0.5', dim.tone]}>{dim.value}</div>
          </div>
        ))
      }
    </div>

    <div class="pt-2 flex items-center justify-between text-[11px] text-zinc-400 font-mono">
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        Cluster: nomic-embed-v1.5 (local quantized)
      </span>
      <span class="text-emerald-400">12.4ms avg</span>
    </div>
  </div>
</div>
