---
import { profile } from '../data/site';

const footerNav = [
  { label: 'Index', href: '/' },
  { label: 'Work', href: '/#projects' },
  { label: 'Timeline', href: '/#updates' },
  { label: 'Writing', href: '/#blog' },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer
  class="border-t border-zinc-200/80 dark:border-slate-800 py-12 bg-white dark:bg-canvas-dark relative z-20"
>
  <div
    class="max-w-6xl mx-auto px-6 sm:px-10 flex flex-col md:flex-row items-center justify-between gap-6 text-xs font-mono text-zinc-500 dark:text-zinc-400"
  >
    <div class="flex items-center gap-2">
      <span class="font-semibold text-zinc-900 dark:text-zinc-100">{profile.handle}</span>
      <span class="text-zinc-300 dark:text-slate-700">/</span>
      <span>© {profile.copyrightYear} {profile.name}. Crafted with care &amp; precision.</span>
    </div>

    <div class="flex items-center gap-6">
      {
        footerNav.map((item) => (
          <a
            href={item.href}
            class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={profile.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Source</a
      >
    </div>
  </div>
</footer>
