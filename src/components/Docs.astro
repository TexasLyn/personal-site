---
import { getCollection } from 'astro:content';
import { getLang, getSite, postPath } from '../data/site';

const lang = getLang(Astro.currentLocale);
const { blog } = getSite(lang);

const posts = (lang === 'en' ? await getCollection('blogEn') : await getCollection('blog')).sort(
  (a, b) => b.data.date.localeCompare(a.data.date)
);
---

<section class="docs__section section" id="docs">
  <div class="container">
    <h2 class="section__title docs__section-title">{blog.title}</h2>

    <div id="blog-posts-list">
      {
        posts.map((post) => (
          <article class="blog-card">
            <div class="blog-card__inner">
              <div class="blog-card__grid">
                <div class="blog-card__main">
                  <div>
                    <div class="blog-card__meta">
                      <span class="blog-card__tag">{post.data.category}</span>
                      <span>•</span>
                      <time>{post.data.date}</time>
                      <span>•</span>
                      <span>{post.data.readTime}</span>
                    </div>
                    <h3 class="blog-card__title">
                      <a href={postPath(lang, post.id)}>{post.data.title}</a>
                    </h3>
                    <p class="blog-card__excerpt">{post.data.excerpt}</p>
                  </div>
                  <a class="blog-card__more" href={postPath(lang, post.id)}>
                    {blog.readMore} <i class="ri-arrow-right-line" />
                  </a>
                </div>

                {post.data.cover && (
                  <a class="blog-card__cover" href={postPath(lang, post.id)} tabindex="-1">
                    <img src={post.data.cover} alt={post.data.title} loading="lazy" />
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
