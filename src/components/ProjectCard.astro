---
import type { Project } from '../data/site';
import NeuralInspector from './visuals/NeuralInspector.astro';
import AgentOrchestrator from './visuals/AgentOrchestrator.astro';
import AuditReport from './visuals/AuditReport.astro';

type Props = { project: Project };
const { project } = Astro.props;

const visuals = {
  neural: NeuralInspector,
  agent: AgentOrchestrator,
  audit: AuditReport,
};
const Visual = visuals[project.visual];

const stackTone: Record<string, string> = {
  indigo:
    'bg-indigo-50 dark:bg-indigo-950/70 border-indigo-100 dark:border-indigo-800/60 text-indigo-700 dark:text-indigo-300 font-medium',
  sky: 'bg-sky-50 dark:bg-sky-950/70 border-sky-100 dark:border-sky-800/60 text-sky-700 dark:text-sky-300 font-medium',
  emerald:
    'bg-emerald-50 dark:bg-emerald-950/70 border-emerald-100 dark:border-emerald-800/60 text-emerald-700 dark:text-emerald-300 font-medium',
  amber:
    'bg-amber-50 dark:bg-amber-950/70 border-amber-200 dark:border-amber-800/60 text-amber-700 dark:text-amber-300 font-medium',
  zinc: 'bg-zinc-100 dark:bg-slate-800 border-zinc-200 dark:border-slate-700 text-zinc-700 dark:text-zinc-300',
};
---

<article
  class="rounded-3xl border border-zinc-200/90 dark:border-slate-800 bg-gradient-to-br from-zinc-50/60 via-white to-white dark:from-slate-900/60 dark:via-surface-dark dark:to-[#0e1420] p-8 sm:p-10 shadow-sm hover:shadow-xl hover:border-indigo-200 dark:hover:border-indigo-500/40 hover:-translate-y-1 transition-all duration-300"
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
    <div
      class:list={[
        'lg:col-span-6 space-y-5',
        project.visualFirst && 'order-2 lg:order-2',
      ]}
    >
      <div class="flex items-center gap-3">
        <span
          class="font-mono text-xs text-indigo-600 dark:text-indigo-400 font-semibold px-2 py-0.5 bg-indigo-50 dark:bg-indigo-950/60 rounded"
          >{project.index}</span
        >
        <span class="text-zinc-300 dark:text-slate-700">/</span>
        <span
          class:list={[
            'font-mono text-xs flex items-center gap-1.5',
            project.statusTone === 'emerald'
              ? 'text-emerald-600 dark:text-emerald-400 font-medium'
              : 'text-zinc-500 dark:text-zinc-400 uppercase tracking-wide',
          ]}
        >
          {
            project.statusTone === 'emerald' && (
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" />
            )
          }
          {project.status}
        </span>
      </div>

      <h3 class="font-serif text-2xl sm:text-3xl text-zinc-900 dark:text-zinc-100 font-normal">
        {project.title}
      </h3>

      <p class="text-zinc-600 dark:text-zinc-400 font-sans text-base leading-relaxed">
        {project.body}
      </p>

      <div class="flex flex-wrap gap-2 pt-1 font-mono text-xs">
        {
          project.stack.map((tech) => (
            <span
              class:list={[
                'px-2.5 py-1 border rounded-md',
                stackTone[tech.tone] ?? stackTone.zinc,
              ]}
            >
              {tech.label}
            </span>
          ))
        }
      </div>

      <div class="pt-4 flex items-center gap-6 text-sm font-medium">
        <a
          href={project.primaryCta.href}
          class="px-4 py-2 rounded-lg bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:bg-indigo-600 dark:hover:bg-indigo-400 dark:hover:text-white inline-flex items-center gap-1.5 transition-colors shadow-sm"
        >
          <span>{project.primaryCta.label}</span>
          <span class="material-symbols-outlined text-[15px]">arrow_outward</span>
        </a>
        {
          project.secondaryCta && (
            <a
              href={project.secondaryCta.href}
              class="text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white inline-flex items-center gap-1 transition-colors"
            >
              <span>{project.secondaryCta.label}</span>
              <span class="material-symbols-outlined text-[15px]">
                {project.secondaryCta.icon}
              </span>
            </a>
          )
        }
      </div>
    </div>

    <div
      class:list={[
        'lg:col-span-6',
        project.visualFirst && 'order-1 lg:order-1',
      ]}
    >
      <Visual />
    </div>
  </div>
</article>
