---
import { hero } from '../data/site';
---

<section class="home" id="home">
  <img class="home__img" src={hero.image.src} alt={hero.image.alt} loading="lazy" />

  <div class="home__container container grid">
    <div class="home__data">
      <span class="home__data-subtitle mobile-margin" style="margin-left: 3pt;">
        {hero.kicker}
      </span>
      <h1 class="home__data-title" set:html={hero.titleHtml} />
      <a class="button mobile-hide" href={hero.cta.href}>{hero.cta.label}</a>
    </div>

    <div class="home__social">
      {
        hero.socials.map((social) => (
          <a
            class="home__social-link"
            href={social.href}
            title={social.label}
            target={social.href.startsWith('http') ? '_blank' : undefined}
            rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            <i class={social.icon} />
          </a>
        ))
      }
    </div>
  </div>
</section>
