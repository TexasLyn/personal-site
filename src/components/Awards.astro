---
import { getSite } from '../data/site';
import ExperienceTimeline from './ExperienceTimeline.astro';

const { awards } = getSite(Astro.currentLocale);
---

<section class="experience section" id="awards">
  <h2 class="section__title">{awards.title}</h2>

  <div class="experience__container container grid">
    <div class="experience__content grid">
      {
        awards.facts.map((fact) => (
          <div class="experience__data">
            <span class="experience__fact">{fact.value}</span>
            <span class="experience__description">{fact.label}</span>
          </div>
        ))
      }
    </div>

    <div class="experience__milestones-wrap">
      <ul class="experience__milestones">
        {
          awards.items.map((item) => (
            <li
              class:list={[
                'experience__milestone',
                item.current && 'experience__milestone--current',
                item.future && 'experience__milestone--future',
              ]}
              data-year={item.year}
            >
              <span class="experience__milestone-year">{item.year}</span>
              <span class="experience__milestone-text">
                {item.textBold ? <b>{item.text}</b> : item.text}
                {item.result ? (
                  <>
                    {'　'}
                    {item.resultBold ? <b>{item.result}</b> : item.result}
                  </>
                ) : null}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <ExperienceTimeline
      stops={awards.timeline}
      label={Astro.currentLocale === 'en' ? 'Railway timeline of stations' : '成长铁路时间轴'}
    />
  </div>
</section>
