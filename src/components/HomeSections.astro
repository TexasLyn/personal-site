---
import Hero from './Hero.astro';
import About from './About.astro';
import Awards from './Awards.astro';
import Work from './Work.astro';
import Docs from './Docs.astro';
import Subscribe from './Subscribe.astro';
---

<Hero />
<About />
<Awards />
<Work />
<Docs />
<Subscribe />

<script>
  import ScrollReveal from 'scrollreveal';

  const sr = ScrollReveal({
    distance: '48px',
    duration: 850,
    delay: 120,
    reset: false,
  });

  sr.reveal('.home__data, .subscribe__description', { origin: 'top' });
  sr.reveal('.home__social-link', { origin: 'bottom', interval: 100 });
  sr.reveal('.about__data, .experience__content', { origin: 'left' });
  sr.reveal('.about__img, .experience__milestones', { origin: 'right' });
  /* 经历区的铁路自己播动画（铁轨铺开 + 站牌垂落），不走 ScrollReveal */
  sr.reveal('.discover__container', { origin: 'bottom' });
  sr.reveal('.footer__data', { origin: 'top', interval: 100 });
</script>
